    "@types/node": "^24.5.2",
    "commitizen": "^4.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.1",
    "prisma": "^6.16.2",
    "typescript": "^5.9.2",
    "wrangler": "4.40.1"
